# sim/run_rom.do -- ROM as logic (ROM_Logic, generated by fw/tools/gen_rom_v.py) against the hex files.
# Run from sim/, after make fw:
#   vsim -c -do run_rom.do
file mkdir ../build/rom
exec python ../fw/tools/gen_rom_v.py ../fw/build/firmware_imem.hex ../fw/build/app_firmware.hex ../build/rom/rom_images.v
if {[file exists work]} {vdel -all -lib work}
vlib work

vlog -sv ../build/rom/rom_images.v ../rtl/mem/ROM_Logic.v
vlog -sv ../dv/tb/mem/ROM_Logic_tb.sv

vsim -voptargs="+acc" work.ROM_Logic_tb
run -all
if {[batch_mode]} {quit -f}
