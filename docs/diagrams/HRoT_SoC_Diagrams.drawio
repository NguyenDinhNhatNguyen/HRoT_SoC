lor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="75" y="346" width="330" height="44" as="geometry"/></mxCell><mxCell id="n10" value="Poll GUARD.ZERO_DONE&lt;br&gt;(limit SB_GUARD_POLL_LIMIT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="75" y="424" width="330" height="52" as="geometry"/></mxCell><mxCell id="n11" value="ZERO_DONE seen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="510" width="350" height="70" as="geometry"/></mxCell><mxCell id="n12" value="Log ', App locked out'&lt;br&gt;LED = result code, kick WDT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="75" y="614" width="330" height="52" as="geometry"/></mxCell><mxCell id="n13" value="App locked out (result code)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="105" y="700" width="270" height="44" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="Result SB_HW_ERROR 0xE0: App stays in reset anyway,&lt;br&gt;because LOCK is already set" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="340" height="60" as="geometry"/></mxCell><mxCell id="n22" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="545"/><mxPoint x="45" y="910"/></Array></mxGeometry></mxCell><mxCell id="n23" value="Yes" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#2E7D32;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="582" width="40" height="20" as="geometry"/></mxCell><mxCell id="n24" value="LOCK flop set (sticky), zero_busy = 1,&lt;br&gt;zero_cnt = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="605" y="100" width="330" height="60" as="geometry"/></mxCell><mxCell id="n25" value="app_rst = 1 at once&lt;br&gt;(sys_rst OR NOT APP_RUN OR LOCK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="605" y="194" width="330" height="60" as="geometry"/></mxCell><mxCell id="n26" value="Zeroization FSM writes 0 to the App RAM,&lt;br&gt;zero_cnt 0 to 1023 (one word per cycle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="605" y="288" width="330" height="64" as="geometry"/></mxCell><mxCell id="n27" value="zero_busy = 0, zero_done = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="605" y="386" width="330" height="48" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="GUARD write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B58B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="ZERO_DONE bit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="720"/><mxPoint x="480" y="720"/><mxPoint x="480" y="450"/></Array></mxGeometry></mxCell><mxCell id="n33" value="&lt;b&gt;After the lockdown&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#5B6B7F;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="780" width="460" height="280" as="geometry"/></mxCell><mxCell id="n34" value="Release attempt: write APP_CTRL = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="830" width="420" height="40" as="geometry"/></mxCell><mxCell id="n35" value="LOCK = 1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="890" width="260" height="70" as="geometry"/></mxCell><mxCell id="n36" value="App stays in reset. The APP_CTRL write has no effect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="985" width="420" height="50" as="geometry"/></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n34" target="n35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="Yes (always, until POR)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n35" target="n36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="&lt;b&gt;Which resets clear LOCK?&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#5B6B7F;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="50" width="480" height="360" as="geometry"/></mxCell><mxCell id="n40" value="Software reset (SW_RESET key 0x5A5A_0001)&lt;br&gt;LOCK survives, App stays in reset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="440" height="60" as="geometry"/></mxCell><mxCell id="n41" value="Watchdog reset&lt;br&gt;LOCK survives, App stays in reset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="440" height="60" as="geometry"/></mxCell><mxCell id="n42" value="Power-on reset (POR)&lt;br&gt;LOCK cleared, the boot starts again from the beginning" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="440" height="60" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Tests that cover this flow&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#5B6B7F;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="440" width="480" height="300" as="geometry"/></mxCell><mxCell id="n44" value="SoC_Top_tb +TAMPER: one bit of the App ROM flipped. Expected: App stays in reset, RAM reads 0, LED 0xEE, and a later APP_CTRL write fails." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="490" width="440" height="60" as="geometry"/></mxCell><mxCell id="n45" value="SoC_Fw_tb and SoC_App_tb with +TAMPER: the real firmware locks the App out and the Boot_Verifier never reaches VERIFIED." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="570" width="440" height="60" as="geometry"/></mxCell><mxCell id="n46" value="SoC_Fw_tb +FAULT: an access fault on the APP_VER load reaches the trap handler, which runs the same lockdown (mcause 5)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="650" width="440" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="13 Boot_Verifier CHECK FSM"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="1180" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Boot_Verifier CHECK FSM (rtl/periph/Boot_Verifier.v)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="28" as="geometry"/></mxCell><mxCell id="n4" value="sys_rst: verdict cleared (CHECKED, VERIFIED, FAIL = 0), state IDLE" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="300" height="52" as="geometry"/></mxCell><mxCell id="n5" value="IDLE: write CTRL with CHECK = 1&lt;br&gt;and CHECKED = 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="146" width="380" height="90" as="geometry"/></mxCell><mxCell id="n6" value="CHECKED = 1 (a second CHECK is ignored)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="270" width="360" height="44" as="geometry"/></mxCell><mxCell id="n7" value="SHA done and not busy&lt;br&gt;and APP_VER &gt;= MIN_VER?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="348" width="380" height="90" as="geometry"/></mxCell><mxCell id="n8" value="FETCH: cnt = 0, mismatch = 0&lt;br&gt;rom_addr = MODE ? 0xFC0 (HMAC tag) : 0xFE0 (golden hash)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="472" width="360" height="64" as="geometry"/></mxCell><mxCell id="n9" value="Each cycle: ROM word = digest word H[cnt]?&lt;br&gt;If not, mismatch = 1. rom_addr += 4, cnt += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="570" width="360" height="64" as="geometry"/></mxCell><mxCell id="n10" value="cnt = 7 (last word)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="668" width="380" height="70" as="geometry"/></mxCell><mxCell id="n11" value="mismatch, or last word differs?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="772" width="380" height="80" as="geometry"/></mxCell><mxCell id="n12" value="VERIFIED = 1, MIN_VER = APP_VER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="886" width="360" height="48" as="geometry"/></mxCell><mxCell id="n13" value="Back to IDLE (verdict is held)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="968" width="300" height="44" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="No (next word)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="703"/><mxPoint x="730" y="602"/></Array></mxGeometry></mxCell><mxCell id="n24" value="FAIL = 1&lt;br&gt;(App stays held, firmware calls fail())" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="368" width="340" height="56" as="geometry"/></mxCell><mxCell id="n25" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="812"/><mxPoint x="880" y="396"/></Array></mxGeometry></mxCell><mxCell id="n27" value="No (ignored)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="191"/><mxPoint x="120" y="990"/></Array></mxGeometry></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="990"/></Array></mxGeometry></mxCell><mxCell id="n29" value="&lt;b&gt;STATUS register (offset 0x04)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="340" height="200" as="geometry"/></mxCell><mxCell id="n30" value="bit 0 VERIFIED&lt;br&gt;bit 1 FAIL&lt;br&gt;bit 2 KEY_LOCKED&lt;br&gt;bit 3 CHECKED&lt;br&gt;bit 4 BUSY (state = FETCH)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="300" height="140" as="geometry"/></mxCell><mxCell id="n31" value="Rules: CHECK runs once per system reset. A passing CHECK raises MIN_VER to APP_VER. MIN_VER and KEY_LOCK survive sys_rst, only POR clears them. While BUSY the ROM Port B belongs to this block." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="1000" width="340" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="14 Secure DMA FSM and Firewall Decision"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="1000" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Secure DMA FSM and Firewall Decision (rtl/bus/Secure_DMA.v, DMA_Firewall.v)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1000" height="28" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;START with NBLK &gt; 0: BUSY = 1, ptr = SRC, left = NBLK, w = 0, first = 1. NBLK = 0: DONE at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="300" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;RD&lt;/b&gt;&lt;br&gt;Read the source word at ptr (App ROM). Swap the bytes of the response if SWAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="300" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;WR&lt;/b&gt;&lt;br&gt;Write the word into SHA W[w]. Then ptr += 4, w += 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="300" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;CTL&lt;/b&gt;&lt;br&gt;w = 15: write SHA CTRL = START (and INIT on the first block)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="360" width="300" height="90" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;POLL&lt;/b&gt;&lt;br&gt;Read SHA STATUS until DONE = 1. A not-done answer polls again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="300" height="90" as="geometry"/></mxCell><mxCell id="n9" value="Request read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="Word received" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="w &lt; 15, data blocks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="280"/><mxPoint x="630" y="280"/></Array></mxGeometry></mxCell><mxCell id="n12" value="w = 15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="CTRL written" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="left &gt; 1: left -= 1, w = 0.&lt;br&gt;Back to RD for the next 64-byte block" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="540" width="300" height="60" as="geometry"/></mxCell><mxCell id="n15" value="left = 1 and PAD: switch to the padding block (in_pad = 1, w = 0).&lt;br&gt;Back to WR to write the padding words, then CTL and POLL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="360" height="70" as="geometry"/></mxCell><mxCell id="n16" value="left = 1 without PAD, or the padding block hashed:&lt;br&gt;BUSY = 0, DONE = 1, back to IDLE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="540" width="300" height="64" as="geometry"/></mxCell><mxCell id="n17" value="DONE, more blocks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="DONE, last block with PAD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="420"/></Array></mxGeometry></mxCell><mxCell id="n19" value="DONE, last block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="440"/><mxPoint x="840" y="572"/></Array></mxGeometry></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="570"/><mxPoint x="440" y="170"/></Array></mxGeometry></mxCell><mxCell id="n21" value="padding words" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="575"/><mxPoint x="30" y="70"/><mxPoint x="1050" y="70"/></Array></mxGeometry></mxCell><mxCell id="n22" value="In RD, WR, CTL and POLL: fw_viol sets ERR_FW. A bus error response (resp_err) sets ERR_BUS.&lt;br&gt;Either way: BUSY = 0, DONE = 1, back to IDLE, no trap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="580" height="70" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Firewall decision for every request (DMA_Firewall.v)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="700" width="780" height="250" as="geometry"/></mxCell><mxCell id="n24" value="aligned?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="730" y="790" width="150" height="70" as="geometry"/></mxCell><mxCell id="n25" value="write?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="790" width="130" height="70" as="geometry"/></mxCell><mxCell id="n26" value="Read: App ROM window&lt;br&gt;0x6000_0000 + 4 KB, or&lt;br&gt;SHA STATUS 0x5000_0044?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="750" width="190" height="70" as="geometry"/></mxCell><mxCell id="n27" value="Write: SHA registers&lt;br&gt;0x5000_0000 to 0x5000_0043?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="850" width="190" height="60" as="geometry"/></mxCell><mxCell id="n28" value="allow" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="765" width="120" height="40" as="geometry"/></mxCell><mxCell id="n29" value="violation: ERR_FW" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1310" y="860" width="160" height="40" as="geometry"/></mxCell><mxCell id="n30" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="925"/><mxPoint x="1390" y="925"/></Array></mxGeometry></mxCell><mxCell id="n32" value="No (read)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="Yes (write)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="15 Bus Transaction and Error Flow"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="1280" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Bus Transaction and Error Flow (AXI4_Lite_Master.v, SoC_Top.v, SYSCSR.v)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1000" height="28" as="geometry"/></mxCell><mxCell id="n4" value="Master Core runs lw or sw&lt;br&gt;(or the Secure DMA issues a request)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="280" height="56" as="geometry"/></mxCell><mxCell id="n5" value="bus_stall = 1 until the response arrives&lt;br&gt;Arbiter grants one master, Round-Robin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="150" width="340" height="60" as="geometry"/></mxCell><mxCell id="n6" value="AXI4-Lite Master FSM: address and data phase&lt;br&gt;IDLE, WRITE_ADDR_DATA, WRITE_RESP, READ_ADDR, READ_DATA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="244" width="340" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Address decode" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="342" width="360" height="70" as="geometry"/></mxCell><mxCell id="n8" value="Selected slave answers&lt;br&gt;RAM, Boot ROM, App ROM, SHA-256, APB bridge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="446" width="340" height="60" as="geometry"/></mxCell><mxCell id="n9" value="Response code" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="540" width="360" height="70" as="geometry"/></mxCell><mxCell id="n10" value="OKAY: data returns, bus_stall = 0,&lt;br&gt;the pipeline continues" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="644" width="340" height="56" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="Hit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="OKAY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="No hit: Default Slave answers DECERR&lt;br&gt;(the bus never hangs, reads return 0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="347" width="330" height="60" as="geometry"/></mxCell><mxCell id="n18" value="No hit, or outside the 4 KB of a memory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="SLVERR sources: write to Boot ROM or App ROM,&lt;br&gt;APB window with no slave (PSLVERR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="347" width="340" height="60" as="geometry"/></mxCell><mxCell id="n20" value="Bus Error Capture: SYSCSR.BUS_ERR keeps the first error&lt;br&gt;(VALID, WRITE, RESP, OVERFLOW) and BUS_ERR_ADDR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="750" width="340" height="66" as="geometry"/></mxCell><mxCell id="n21" value="SLVERR or DECERR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="575"/><mxPoint x="700" y="575"/><mxPoint x="700" y="783"/></Array></mxGeometry></mxCell><mxCell id="n22" value="DECERR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="783"/></Array></mxGeometry></mxCell><mxCell id="n23" value="Master of this access?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="880" width="260" height="84" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n20" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="CPU: data_err = 1 in the same cycle as resp_valid&lt;br&gt;Trap: mcause 5 (load) or 7 (store), mtval = address" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="340" height="70" as="geometry"/></mxCell><mxCell id="n26" value="DMA: STATUS.ERR_BUS = 1, the DMA aborts&lt;br&gt;BUSY = 0, DONE = 1, no trap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="1030" width="330" height="70" as="geometry"/></mxCell><mxCell id="n27" value="CPU" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="DMA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="Firmware trap_handler (Master): log mcause, mepc, mtval,&lt;br&gt;then fail(SB_TRAP 0xAF): LOCK the App, show the code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="340" height="70" as="geometry"/></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n25" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="The App bus is a separate, single-cycle APB bus: it ignores PSLVERR and the App Core data_err input is tied to 0." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="1150" width="330" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p15" name="16 Interrupt and Trap Flow"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="1180" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Interrupt and Trap Flow (CSR_Unit.v, crt0.S, secure_boot.c)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="28" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Asynchronous: interrupts&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="520" height="720" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Synchronous: exceptions&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF7EC;strokeColor=#82B366;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="580" y="50" width="460" height="720" as="geometry"/></mxCell><mxCell id="n6" value="Source raises its level line" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="100" width="360" height="44" as="geometry"/></mxCell><mxCell id="n7" value="TIMER0: mtime &gt;= mtimecmp, goes straight to irq_timer&lt;br&gt;PLIC-lite: UART0, GPIO0, DMA, Mailbox, goes to irq_ext" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="178" width="420" height="70" as="geometry"/></mxCell><mxCell id="n8" value="mip.MTIP (bit 7) or mip.MEIP (bit 11) set, level held until the source clears" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="282" width="420" height="60" as="geometry"/></mxCell><mxCell id="n9" value="mstatus.MIE = 1 and the mie bit set&lt;br&gt;and the instruction is not a load or store?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="376" width="440" height="100" as="geometry"/></mxCell><mxCell id="n10" value="Take the trap: mepc = PC, mcause = 0x8000_000B (MEI) or 0x8000_0007 (MTI)&lt;br&gt;MEI has priority. MPIE = MIE, MIE = 0, PC = mtvec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="420" height="80" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="No: the interrupt waits. After reset MIE = 0 and mie = 0, so firmware that does not enable them runs unchanged. A load or store is never cut or replayed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="460" height="50" as="geometry"/></mxCell><mxCell id="n16" value="Instruction in MEM raises an exception" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="340" height="44" as="geometry"/></mxCell><mxCell id="n17" value="illegal instruction: mcause 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="340" height="40" as="geometry"/></mxCell><mxCell id="n18" value="EBREAK: mcause 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="240" width="340" height="40" as="geometry"/></mxCell><mxCell id="n19" value="ECALL: mcause 11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="340" height="40" as="geometry"/></mxCell><mxCell id="n20" value="access fault on load (data_err): mcause 5, mtval = address" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="360" width="340" height="40" as="geometry"/></mxCell><mxCell id="n21" value="access fault on store (data_err): mcause 7, mtval = address" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="340" height="40" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="Take the trap: mepc = PC of the instruction, mcause as above,&lt;br&gt;MPIE = MIE, MIE = 0, PC = mtvec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="490" width="340" height="66" as="geometry"/></mxCell><mxCell id="n24" value="Older instructions finish, younger ones are flushed. A load that faulted does not write its register." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="580" width="340" height="50" as="geometry"/></mxCell><mxCell id="n25" value="MRET (when a handler returns): MIE = MPIE, PC = mepc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="650" width="340" height="44" as="geometry"/></mxCell><mxCell id="n26" value="crt0.S trap_entry: start a fresh stack, read mcause, mepc, mtval" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="830" width="360" height="56" as="geometry"/></mxCell><mxCell id="n27" value="call trap_handler(mcause, mepc, mtval)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="920" width="360" height="44" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="790"/><mxPoint x="470" y="790"/></Array></mxGeometry></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="800"/><mxPoint x="570" y="800"/></Array></mxGeometry></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="Which firmware?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="1000" width="280" height="70" as="geometry"/></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n27" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="Master: secure_boot_trap() logs the cause, then fail(SB_TRAP 0xAF)&lt;br&gt;LOCK the App and the key, LED 0xAF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="440" height="60" as="geometry"/></mxCell><mxCell id="n34" value="App demo: weak trap_handler loops for ever&lt;br&gt;(MRET restores MIE and returns to mepc if a handler uses it)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="1100" width="440" height="60" as="geometry"/></mxCell><mxCell id="n35" value="Secure Boot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="App" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p16" name="17 Reset and Power Flow"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="880" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Reset and Power Flow (SYSCSR.v, Boot_Verifier.v, SoC_Top.v)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="28" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Power-on reset (POR)&lt;/b&gt;&lt;br&gt;reset_system: power or push button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="240" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Watchdog timeout&lt;/b&gt;&lt;br&gt;WDT, wdt_rst_req" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="240" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Software reset&lt;/b&gt;&lt;br&gt;Write SW_RESET = 0x5A5A_0001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="240" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Reset Generator (SYSCSR)&lt;/b&gt;&lt;br&gt;Holds sys_rst high for RST_HOLD cycles after the last request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="240" width="280" height="90" as="geometry"/></mxCell><mxCell id="n8" value="por_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="wdt_rst_req" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="sw_req" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="&lt;b&gt;Cleared by every sys_rst (POR, WDT, software reset)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="700" height="250" as="geometry"/></mxCell><mxCell id="n12" value="Bus, interconnect, peripherals, SHA-256, Secure DMA, Mailbox, App world peripherals (via app_rst)&lt;br&gt;Boot_Verifier verdict: CHECKED, VERIFIED, FAIL, APP_VER&lt;br&gt;APP_RUN = 0, so app_rst = 1 and the App Core is held&lt;br&gt;BUS_ERR capture&lt;br&gt;Master Core restarts at 0x0000_0000 and runs Secure Boot again" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="100" width="640" height="160" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Cleared only by POR&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="360" width="700" height="230" as="geometry"/></mxCell><mxCell id="n14" value="Boot Guard LOCK, ZERO_BUSY, ZERO_DONE: the App stays locked after a failed boot&lt;br&gt;Boot_Verifier MIN_VER: the anti-rollback floor&lt;br&gt;Boot_Verifier KEY_LOCK: the key stays hidden after use&lt;br&gt;RST_CAUSE: set to POR by POR, WDT and SW bits are added by those resets (RW1C to clear)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="400" width="640" height="160" as="geometry"/></mxCell><mxCell id="n15" value="sys_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B58B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="A hung boot is caught by the WDT, which started before the hash. The reset keeps LOCK, so a boot that failed once cannot release the App after a watchdog reset." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="320" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p17" name="18 Verification Flow"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1000" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Verification Flow (make test, sim/regress.sh, then the FPGA flow)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1000" height="28" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Sources&lt;/b&gt;&lt;br&gt;rtl, dv, fw, vp, sim scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="170" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;make test (QuestaSim 10.2c and SystemC, run in WSL)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="50" width="1050" height="570" as="geometry"/></mxCell><mxCell id="n6" value="Core" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="200" height="24" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;11 unit testbenches&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="115" width="230" height="50" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;ISA program, trap test&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;st