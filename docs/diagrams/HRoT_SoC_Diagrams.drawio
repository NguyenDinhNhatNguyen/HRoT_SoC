" parent="1" source="n28" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="Instruction in MEM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1082" y="340"/><mxPoint x="1000" y="340"/></Array></mxGeometry></mxCell><mxCell id="n34" value="Trap / MRET Redirect (mtvec, mepc)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="560"/><mxPoint x="90" y="560"/></Array></mxGeometry></mxCell><mxCell id="n35" value="&lt;b&gt;Interrupt Lines&lt;/b&gt;&lt;br&gt;irq_timer, irq_ext (level, high)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="400" width="230" height="60" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Bus Response Error&lt;/b&gt;&lt;br&gt;data_err: SLVERR or DECERR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="490" width="230" height="60" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Bus Stall&lt;/b&gt;&lt;br&gt;bus_stall freezes the whole pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="580" width="230" height="60" as="geometry"/></mxCell><mxCell id="n38" value="MTIP, MEIP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n35" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="mcause 5 (load), 7 (store)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="n36" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n40" value="Branch and jump are resolved in EX and flush IF/ID and ID/EX. Interrupts are taken only on an instruction that does not access memory, so a load or store is never cut or replayed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="200" y="620" width="760" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="05 Secure DMA, Firewall, SHA-256"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="800" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;Secure DMA, DMA Firewall and SHA-256 (rtl/bus/Secure_DMA.v, DMA_Firewall.v, rtl/crypto)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D79B00;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1520" height="760" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;DMA Registers (APB +0x7000)&lt;/b&gt;&lt;br&gt;SRC, NBLK, CTRL (START, SWAP, PAD, IRQ_EN), STATUS (BUSY, DONE, ERR_FW, ERR_BUS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="290" height="110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;DMA FSM&lt;/b&gt;&lt;br&gt;IDLE, RD, WR, CTL, POLL. Owns SHA-256 while BUSY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="250" height="110" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;DMA Firewall&lt;/b&gt;&lt;br&gt;Combinational, blocks before the bus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="250" height="110" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Arbiter to AXI4-Lite Master&lt;/b&gt;&lt;br&gt;Shared with the CPU, Round-Robin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="250" height="110" as="geometry"/></mxCell><mxCell id="n8" value="Start, SRC, NBLK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="Allowed Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="fw_viol (ERR_FW)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="80"/><mxPoint x="595" y="80"/></Array></mxGeometry></mxCell><mxCell id="n12" value="Response (resp_valid, resp_err)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1375" y="275"/><mxPoint x="595" y="275"/></Array></mxGeometry></mxCell><mxCell id="n13" value="&lt;b&gt;Firewall Rules&lt;/b&gt;&lt;br&gt;Read: App ROM window 0x6000_0000 (4 KB) and SHA STATUS. Write: SHA block registers and CTRL (0x5000_0000 to 0x5000_0043). Aligned only. Everything else is blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="340" width="330" height="120" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="310"/><mxPoint x="985" y="310"/></Array></mxGeometry></mxCell><mxCell id="n15" value="&lt;b&gt;App ROM (Port B)&lt;/b&gt;&lt;br&gt;Source of the 64-byte blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="420" width="220" height="60" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;SHA-256 Wrapper (0x5000_0000)&lt;/b&gt;&lt;br&gt;W0..W15, CTRL (START, INIT), STATUS (DONE, BUSY), HASH H0..H7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="520" width="360" height="80" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;SHA-256 Core&lt;/b&gt;&lt;br&gt;64 Rounds, 66 Cycles per Block, multi-block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="660" width="360" height="70" as="geometry"/></mxCell><mxCell id="n18" value="Read Source Word" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#9673A6;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="320"/><mxPoint x="1210" y="320"/></Array></mxGeometry></mxCell><mxCell id="n19" value="START, Poll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1515" y="175"/><mxPoint x="1515" y="560"/></Array></mxGeometry></mxCell><mxCell id="n20" value="Block, Start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="Digest, Done, Busy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="&lt;b&gt;Boot_Verifier&lt;/b&gt;&lt;br&gt;Reads digest_out, done_out, busy_out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="250" height="60" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Master Core (CPU)&lt;/b&gt;&lt;br&gt;Reads HASH over AXI4-Lite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="640" width="250" height="60" as="geometry"/></mxCell><mxCell id="n24" value="digest_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="584"/></Array></mxGeometry></mxCell><mxCell id="n25" value="HASH registers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="544"/></Array></mxGeometry></mxCell><mxCell id="n26" value="SWAP = 1 reverses the bytes of each word, so the digest equals sha256sum of the .bin (little-endian image). PAD = 1 hashes the padding block for NBLK x 64 bytes. NBLK = 0 reports DONE with no hash." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="560" height="60" as="geometry"/></mxCell><mxCell id="n27" value="DONE and IRQ_EN raise dma_irq into PLIC-lite source 2." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="06 Boot_Verifier"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="780" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;Boot_Verifier (rtl/periph/Boot_Verifier.v, APB +0x8000)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="960" height="700" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;SHA-256 Wrapper&lt;/b&gt;&lt;br&gt;digest_out (256 bit), done_out, busy_out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;APB Master (Master Core)&lt;/b&gt;&lt;br&gt;Writes CTRL, APP_VER, MIN_VER. Reads STATUS, KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;CHECK Gate&lt;/b&gt;&lt;br&gt;CHECK accepted once per reset. Needs SHA done, not busy, APP_VER &gt;= MIN_VER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="250" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;CHECK FSM&lt;/b&gt;&lt;br&gt;IDLE, FETCH (8 cycles). rom_addr += 4, busy = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="210" height="100" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;MIN_VER&lt;/b&gt;&lt;br&gt;Anti-rollback floor. Writes only raise it. Raised to APP_VER after a pass. POR clears" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="270" width="250" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Word Comparator&lt;/b&gt;&lt;br&gt;ROM word i equals digest word H[i]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="270" width="210" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Verdict Logic&lt;/b&gt;&lt;br&gt;Any mismatch: FAIL. Word 7 matched: VERIFIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="210" height="90" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;STATUS&lt;/b&gt;&lt;br&gt;VERIFIED, FAIL, CHECKED, BUSY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="430" width="190" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;KEY0..7 + KEY_LOCK&lt;/b&gt;&lt;br&gt;Demo HMAC key. Reads 0 after KEY_LOCK. Sticky until POR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="190" height="90" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Boot ROM (Port B)&lt;/b&gt;&lt;br&gt;Golden Hash 0xFE0 or HMAC Tag 0xFC0. Port B is lent while busy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1330" y="100" width="190" height="90" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;SYSCSR&lt;/b&gt;&lt;br&gt;VERIFY_GATE input: verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1330" y="430" width="190" height="80" as="geometry"/></mxCell><mxCell id="n15" value="done, busy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="Digest Word H[i]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#D79B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="20"/><mxPoint x="635" y="20"/><mxPoint x="635" y="310"/></Array></mxGeometry></mxCell><mxCell id="n17" value="CTRL.CHECK, APP_VER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="245"/><mxPoint x="340" y="245"/></Array></mxGeometry></mxCell><mxCell id="n18" value="MIN_VER Write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="Read KEY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="605"/><mxPoint x="1040" y="605"/></Array></mxGeometry></mxCell><mxCell id="n20" value="Start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="MIN_VER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="rom_addr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#9673A6;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="rom_data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#9673A6;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1425" y="330"/></Array></mxGeometry></mxCell><mxCell id="n24" value="Word Index" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="Match or Mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="Set VERIFIED or FAIL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="Raise MIN_VER (on pass)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="475"/></Array></mxGeometry></mxCell><mxCell id="n28" value="verified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="CHECK is accepted once per reset. A new system reset clears the verdict. MIN_VER and KEY_LOCK survive it and only POR clears them." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="690" width="760" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="07 SYSCSR and Boot Guard"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="800" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;SYSCSR (rtl/periph/SYSCSR.v, APB +0x0000)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="40" width="1000" height="720" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;por_rst&lt;/b&gt;&lt;br&gt;Power-on or push button, synchronized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;WDT Reset Request&lt;/b&gt;&lt;br&gt;wdt_rst_req pulse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="56" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;AXI4-Lite Master&lt;/b&gt;&lt;br&gt;bus_err pulse, write flag, resp, address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Boot_Verifier&lt;/b&gt;&lt;br&gt;verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="447" width="200" height="56" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;APB Master (Master Core)&lt;/b&gt;&lt;br&gt;APP_CTRL, SW_RESET, GUARD, BUS_ERR clear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="200" height="70" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Reset Generator&lt;/b&gt;&lt;br&gt;POR, WDT request or SW_RESET key 0x5A5A_0001. Holds sys_rst for RST_HOLD cycles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="270" height="90" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;RST_CAUSE (RW1C)&lt;/b&gt;&lt;br&gt;POR, WDT, SW bits. Survives SW and WDT reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="270" height="70" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Bus Error Capture&lt;/b&gt;&lt;br&gt;BUS_ERR: first error, overflow, W1C. BUS_ERR_ADDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="270" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;LOCK (GUARD bit 0)&lt;/b&gt;&lt;br&gt;Sticky. Cleared only by POR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="220" height="70" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Zeroization FSM&lt;/b&gt;&lt;br&gt;Counter 0..1023 writes zero into the App RAM. ZERO_BUSY, ZERO_DONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="250" height="80" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;APP_RUN Register&lt;/b&gt;&lt;br&gt;Reset by sys_rst. Write 1 only if verified (VERIFY_GATE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="190" height="90" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;app_rst&lt;/b&gt;&lt;br&gt;sys_rst OR NOT APP_RUN OR LOCK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1000" y="430" width="250" height="80" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Secure World sys_rst&lt;/b&gt;&lt;br&gt;Resets bus, peripherals, SHA, DMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#999999;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="90" width="190" height="60" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;App RAM&lt;/b&gt;&lt;br&gt;write zero (app_zero_en, app_zero_addr)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="220" width="190" height="70" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;App Core and App peripherals&lt;/b&gt;&lt;br&gt;Held in reset while app_rst = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="430" width="190" height="80" as="geometry"/></mxCell><mxCell id="n19" value="por_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="wdt_rst_req" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="sys_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="Cause" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B58B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="bus_err" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="verified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="APP_CTRL write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="795" y="585"/></Array></mxGeometry></mxCell><mxCell id="n26" value="GUARD.LOCK write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C8B3B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="564"/><mxPoint x="650" y="255"/></Array></mxGeometry></mxCell><mxCell id="n27" value="Start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="Zeroization" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="260"/><mxPoint x="1300" y="255"/></Array></mxGeometry></mxCell><mxCell id="n29" value="APP_RUN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B58B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="LOCK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="909" y="485"/></Array></mxGeometry></mxCell><mxCell id="n31" value="app_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B58B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n15" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="LOCK is cleared only by POR, so no software or watchdog reset can unlock the App after a failed boot. RST_CAUSE and LOCK are never cleared by sys_rst. Read-only registers: CHIP_ID 0x4852_4F54, VERSION, BOOT_STRAP." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="640" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="08 Secure Peripherals and Interrupts"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="700" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;Secure Peripherals (rtl/periph, APB slots 1 to 7)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1520" height="660" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;UART0 (+0x1000)&lt;/b&gt;&lt;br&gt;8N1, 16x sampling, 8-byte FIFOs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="60" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;GPIO0 (+0x2000)&lt;/b&gt;&lt;br&gt;8 outputs (LEDs), 8 inputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="220" height="60" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Secure DMA (+0x7000)&lt;/b&gt;&lt;br&gt;dma_irq on DONE when IRQ_EN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="220" height="60" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Mailbox, Secure side (+0x6000)&lt;/b&gt;&lt;br&gt;mbox_irq_s when the App has a word waiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="220" height="60" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;WDT (+0x4000)&lt;/b&gt;&lt;br&gt;LOAD, KICK key 0x5A5A_0002, reset on timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="220" height="60" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;PLIC-lite (+0x5000)&lt;/b&gt;&lt;br&gt;8 level sources, lowest index wins. Claim and Complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="240" height="140" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;TIMER0 (+0x3000)&lt;/b&gt;&lt;br&gt;CLINT style: mtime, mtimecmp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="240" height="60" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Master Core&lt;/b&gt;&lt;br&gt;mip.MTIP (irq_timer), mip.MEIP (irq_ext). MEI before MTI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="240" height="90" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;SYSCSR&lt;/b&gt;&lt;br&gt;RST_CAUSE bit 1: WDT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="520" width="240" height="60" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Mailbox, App side (0x4000_3000 on the App bus)&lt;/b&gt;&lt;br&gt;irq_a into the App Core irq_ext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="240" height="70" as="geometry"/></mxCell><mxCell id="n14" value="Source 0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="Source 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=