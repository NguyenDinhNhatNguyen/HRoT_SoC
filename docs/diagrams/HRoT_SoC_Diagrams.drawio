lt;/b&gt;&lt;br&gt;Port A: instruction fetch. Port B belongs to the Secure bus (read-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="230" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;App Core&lt;/b&gt;&lt;br&gt;RISCV_Core, same RTL as the Master Core. Reset by app_rst" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;App RAM 4 KB&lt;/b&gt;&lt;br&gt;Reached by any address outside 0x4000_xxxx (alias). Zeroized by Boot Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="230" height="90" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;App APB Decoder&lt;/b&gt;&lt;br&gt;0x4000_xxxx, 4 slaves, one cycle, PSLVERR ignored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;UART1 (+0x0000)&lt;/b&gt;&lt;br&gt;Same layout as UART0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="220" height="56" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;GPIO1 (+0x1000)&lt;/b&gt;&lt;br&gt;LEDG[8:1] on the DE2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helveti