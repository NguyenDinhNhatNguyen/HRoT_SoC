xGeometry></mxCell><mxCell id="n25" value="irq_ext" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="70"/><mxPoint x="40" y="70"/><mxPoint x="40" y="345"/></Array></mxGeometry></mxCell><mxCell id="n26" value="irq_timer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="328"/><mxPoint x="1070" y="90"/><mxPoint x="30" y="90"/><mxPoint x="30" y="370"/></Array></mxGeometry></mxCell><mxCell id="n27" value="app_rst (hold)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B58B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="Zeroization" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B58B00;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="Two-Way Message Words" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#9673A6;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="Peripherals of the App World are reset by app_rst, the Mailbox by sys_rst. The App ROM image is hashed through its Port B by the Secure DMA before the App Core is released." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="630" width="700" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="10 Security Architecture"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1620" pageHeight="760" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Chain of Trust and Protection Layers (docs/spec/Security_Model.md, SR-01 to SR-11)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="900" height="28" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Chain of Trust: boot to release&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF1FA;strokeColor=#1E3A8A;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1580" height="250" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Boot ROM&lt;/b&gt;&lt;br&gt;Immutable code and Golden Hash. No write path (SR-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Secure Boot Firmware&lt;/b&gt;&lt;br&gt;Runs on the Master Core only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="263" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Secure DMA + Firewall&lt;/b&gt;&lt;br&gt;Reads only App ROM, writes only SHA-256 (SR-08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="486" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;SHA-256&lt;/b&gt;&lt;br&gt;Digest of the whole 4 KB App image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="709" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Boot_Verifier&lt;/b&gt;&lt;br&gt;Hardware compare, anti-rollback (SR-03, SR-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="932" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;VERIFY_GATE&lt;/b&gt;&lt;br&gt;APP_RUN ignored until VERIFIED (SR-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1155" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;App Core&lt;/b&gt;&lt;br&gt;Held in reset until released (SR-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1378" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="&lt;b&gt;Protection layers around the chain&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#5B6B7F;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1F2937;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1580" height="400" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Boot Guard LOCK&lt;/b&gt;&lt;br&gt;Sticky until POR. Locks the App after a failed boot (SR-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="340" height="90" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Zeroization&lt;/b&gt;&lt;br&gt;Hardware clears the App RAM on LOCK (SR-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="445" y="400" width="340" height="90" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;KEY_LOCK&lt;/b&gt;&lt;br&gt;Hides the HMAC key after use, sticky until POR (SR-07)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="400" width="340" height="90" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;MIN_VER&lt;/b&gt;&lt;br&gt;Refuses an older App image (SR-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1215" y="400" width="340" height="90" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;App Bus Isolation&lt;/b&gt;&lt;br&gt;App Core has no path to the Secure bus (SR-09)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="340" height="90" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;4 KB Address Decode&lt;/b&gt;&lt;br&gt;Reads outside a memory give DECERR, no alias (SR-10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="445" y="540" width="340" height="90" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;BUS_ERR Capture&lt;/b&gt;&lt;br&gt;First bus error and its address are kept for firmware (SR-11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="340" height="90" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;WDT&lt;/b&gt;&lt;br&gt;Resets a hung boot. LOCK survives the reset (SR-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1215" y="540" width="340" height="90" as="geometry"/></mxCell><mxCell id="n27" value="Any failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1008" y="372"/><mxPoint x="230" y="372"/></Array></mxGeometry></mxCell><mxCell id="n28" value="Every failed boot ends in the same fail() routine: kick WDT, hide the key, set LOCK, wait for ZERO_DONE, log, show the code on the LEDs." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1000" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="11 Secure Boot Flow"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="1560" background="#DCE6F2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Secure Boot Flow (fw/secure_boot/secure_boot.c, secure_boot_run)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="28" as="geometry"/></mxCell><mxCell id="n4" value="Reset (POR)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="205" y="50" width="250" height="40" as="geometry"/></mxCell><mxCell id="n5" value="Master Core boots from Boot ROM 0x0000_0000&lt;br&gt;SYSCSR holds App Core in reset (APP_RUN = 0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="124" width="330" height="54" as="geometry"/></mxCell><mxCell id="n6" value="Init UART0, start WDT (SB_WDT_LOAD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="212" width="330" height="40" as="geometry"/></mxCell><mxCell id="n7" value="SHA-256 self-test OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="155" y="286" width="350" height="70" as="geometry"/></mxCell><mxCell id="n8" value="Clear BUS_ERR. Secure DMA hashes the 4 KB App ROM (SWAP + PAD), kick WDT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="390" width="330" height="56" as="geometry"/></mxCell><mxCell id="n9" value="Bus error or DMA error?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="155" y="480" width="350" height="70" as="geometry"/></mxCell><mxCell id="n10" value="Read golden hash from Boot ROM 0xFE0 (8 words)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="584" width="330" height="44" as="geometry"/></mxCell><mxCell id="n11" value="Bus error while reading?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="155" y="662" width="350" height="70" as="geometry"/></mxCell><mxCell id="n12" value="Digest = Golden?&lt;br&gt;(software, constant time)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="155" y="766" width="350" height="80" as="geometry"/></mxCell><mxCell id="n13" value="Read APP_VER from App ROM 0x6000_0FFC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="880" width="330" height="44" as="geometry"/></mxCell><mxCell id="n14" value="Bus error while reading?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="155" y="958" width="350" height="70" as="geometry"/></mxCell><mxCell id="n15" value="bv_check(APP_VER): Boot_Verifier CHECK&lt;br&gt;hardware compare + anti-rollback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="1062" width="330" height="56" as="geometry"/></mxCell><mxCell id="n16" value="Hardware verdict VERIFIED?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="155" y="1152" width="350" height="70" as="geometry"/></mxCell><mxCell id="n17" value="bv_key_lock(): KEY_LOCK (sticky until POR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="1256" width="330" height="44" as="geometry"/></mxCell><mxCell id="n18" value="Write SYSCSR.APP_CTRL = 1 (APP_RUN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="165" y="1334" width="330" height="44" as="geometry"/></mxCell><mxCell id="n19" value="APP_CTRL reads 1?&lt;br&gt;(release gate open)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=1