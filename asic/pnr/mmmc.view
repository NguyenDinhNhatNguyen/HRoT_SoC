# mmmc.view - read by Innovus (init_mmmc_file) and Tempus (read_view_definition).
# Two corners: slow library for setup and recovery, fast library for hold and removal.
# Variables come from config.tcl and from the script that reads this file (DESIGN_SDC).

create_library_set -name libs_slow -timing [concat [list $LIB_DIR/$LIB_SLOW] [list $SRAM_LIB_SLOW]]
create_library_set -name libs_fast -timing [concat [list $LIB_DIR/$LIB_FAST] [list $SRAM_LIB_FAST]]

# No QRC tech file: the Lab qrc/gpdk045.tch is unreadable (IMPEXT-1211), so RC comes from the tech LEF
create_rc_corner -name rc_typ -T 25

create_delay_corner -name dc_slow -library_set libs_slow -rc_corner rc_typ
create_delay_corner -name dc_fast -library_set libs_fast -rc_corner rc_typ

create_constraint_mode -name func -sdc_files [list $DESIGN_SDC]

create_analysis_view -name av_setup -constraint_mode func -delay_corner dc_slow
create_analysis_view -name av_hold  -constraint_mode func -delay_corner dc_fast

set_analysis_view -setup {av_setup} -hold {av_hold}
